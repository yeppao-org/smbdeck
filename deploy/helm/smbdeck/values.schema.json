{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "smbdeck chart values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "hostPath"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
          },
          "hostPath": {
            "type": "string",
            "pattern": "^/"
          },
          "type": {
            "type": "string",
            "enum": [
              "Directory",
              "DirectoryOrCreate"
            ]
          }
        }
      }
    },
    "filesUid": {
      "type": "integer",
      "minimum": 1
    },
    "filesGid": {
      "type": "integer",
      "minimum": 1
    },
    "samba": {
      "type": "object",
      "properties": {
        "netbiosName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,14}$"
        },
        "serverString": {
          "type": "string",
          "maxLength": 64
        },
        "workgroup": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,14}$"
        },
        "hostsAllow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "logLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "signing": {
          "type": "string",
          "enum": [
            "mandatory",
            "auto"
          ]
        }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "allowedNetworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trustedProxies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "smbHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "passwordMinLength": {
          "type": "integer",
          "minimum": 8,
          "maximum": 128
        },
        "cookieSecure": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ]
        },
        "extraEnv": {
          "type": "array"
        },
        "extraVolumeMounts": {
          "type": "array"
        },
        "allowedHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$"
          }
        }
      }
    },
    "log": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "text",
            "json"
          ]
        }
      }
    },
    "seed": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "config": {
          "type": "object"
        },
        "passwordsSecret": {
          "type": "string"
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "size": {
          "type": "string"
        },
        "keep": {
          "type": "boolean"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "externalTrafficPolicy": {
          "type": "string",
          "enum": [
            "",
            "Cluster",
            "Local"
          ]
        }
      }
    },
    "smb": {
      "type": "object",
      "properties": {
        "service": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "externalTrafficPolicy": {
              "type": "string",
              "enum": [
                "",
                "Cluster",
                "Local"
              ]
            },
            "allocateLoadBalancerNodePorts": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hosts": {
          "type": "array"
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "discovery": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostName": {
          "type": "string",
          "pattern": "^(|[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)$"
        },
        "address": {
          "type": "string"
        },
        "interface": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{0,15}$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 63
        },
        "workgroup": {
          "type": "string"
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9,]{1,32}$"
        },
        "timeMachineShares": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "webFrom": {
          "type": "array"
        },
        "smbFrom": {
          "type": "array"
        }
      }
    }
  }
}
